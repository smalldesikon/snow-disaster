local Tabs = {
    Tabhx = Window:Tab({ Title = "删除", Icon = "game" }),
}

Tabs.Tabhx:Button({
    Title = "删除VIP墙",
    Callback = function() 
        local function deleteVIPWalls()
            local success, err = pcall(function()
                local workspace = game:GetService("Workspace")
                local sharedInstances = workspace:FindFirstChild("DefaultMap_SharedInstances")
                
                if not sharedInstances then
                    print("未找到 DefaultMap_SharedInstances 文件夹")
                    return
                end
                
                local vipWalls = sharedInstances:FindFirstChild("VIPWalls")
                if not vipWalls then
                    print("未找到VIPWalls文件夹")
                    return
                end
                
                local function destroyAllChildren(parent)
                    for _, child in ipairs(parent:GetChildren()) do
                        destroyAllChildren(child)
                        child:Destroy()
                    end
                end
                
                destroyAllChildren(vipWalls)
                vipWalls:Destroy()
                
                print("成功删除")
            end)
            
            if not success then
                print("执行失败: " .. tostring(err))
            end
        end
        
        deleteVIPWalls()
    end
})

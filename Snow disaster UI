    snow.TextColor3 = Color3.fromRGB(220, 240, 255)
    snow.TextStrokeTransparency = 0.8
    snow.TextStrokeColor3 = Color3.fromRGB(180, 210, 255)
    snow.Font = Enum.Font.GothamBold
    snow.TextScaled = true
    snow.ZIndex = 0
    
    snowflakes[i] = {
        instance = snow,
        speed = math.random(15, 45) / 100,
        wobble = math.random(8, 25) / 100,
        wobbleSpeed = math.random(3, 12) / 10,
        rotationSpeed = math.random(-3, 3)
    }
end

-- 雪花动画连接
local snowConnection = nil

local function StartSnowAnimation()
    if snowConnection then return end
    snowConnection = RunService.RenderStepped:Connect(function(deltaTime)
        for _, snowData in ipairs(snowflakes) do
            local snow = snowData.instance
            local pos = snow.Position
            
            pos = UDim2.new(
                pos.X.Scale, pos.X.Offset,
                pos.Y.Scale + snowData.speed * deltaTime, pos.Y.Offset
            )
            
            local wobble = math.sin(tick() * snowData.wobbleSpeed) * snowData.wobble
            snow.Rotation += snowData.rotationSpeed
            
            if pos.Y.Scale > 1 then
                pos = UDim2.new(math.random(), 0, -0.1, 0)
            end
            
            snow.Position = pos
        end
    end)
end

local function StopSnowAnimation()
    if snowConnection then
        snowConnection:Disconnect()
        snowConnection = nil
    end
end


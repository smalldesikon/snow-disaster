-- ✅ 外部 API：创建 Tab
_G.CreateHubTab = function(name)
	if Tabs[name] then return TabFrames[name] end

	local tabBtn = Instance.new("TextButton", tabBar)
	tabBtn.Size = UDim2.new(0, 90, 1, 0)
	tabBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
	tabBtn.Text = name
	tabBtn.Font = Enum.Font.GothamBold
	tabBtn.TextSize = 14
	tabBtn.TextColor3 = Color3.new(1, 1, 1)
	tabBtn.AutoButtonColor = false
	Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)

	local frame = Instance.new("ScrollingFrame", MainPanel)
	frame.Size = UDim2.new(1, 0, 1, -90)
	frame.Position = UDim2.new(0, 0, 0, 90)
	frame.BackgroundTransparency = 1
	frame.ScrollBarThickness = 4
	frame.Visible = false
	Instance.new("UIListLayout", frame).Padding = UDim.new(0, 8)

	Tabs[name] = tabBtn
	TabFrames[name] = frame

	tabBtn.MouseButton1Click:Connect(function()
		for n, f in pairs(TabFrames) do
			f.Visible = (n == name)
			Tabs[n].BackgroundColor3 =
				(n == name) and Color3.fromRGB(70, 70, 70) or Color3.fromRGB(45, 45, 45)
		end
	end)

	if #Tabs == 1 then
		frame.Visible = true
		tabBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
	end

	return frame
end


local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false

-- 黑色背景
local bg = Instance.new("Frame", gui)
bg.Size = UDim2.fromScale(1, 1)
bg.BackgroundColor3 = Color3.new(0, 0, 0)
bg.BackgroundTransparency = 1

local text = "SNOWDISASTERHUB"
local BLUE = Color3.fromRGB(0, 180, 255)
local WHITE = Color3.new(1, 1, 1)

-- 渐黑（舒服速度）
TweenService:Create(bg, TweenInfo.new(0.8), {BackgroundTransparency = 0}):Play()
task.wait(0.8)

-- 创建字母
local letters = {}
local spacing = 0.056
local startX = 0.5 - (#text * spacing) / 2

for i = 1, #text do
	local lbl = Instance.new("TextLabel", gui)
	lbl.AnchorPoint = Vector2.new(0.5, 0.5)
	lbl.Position = UDim2.new(startX + (i - 1) * spacing + spacing / 2, 0, 0.5, 0)
	lbl.Size = UDim2.fromScale(0.05, 0.1)
	lbl.BackgroundTransparency = 1
	lbl.Text = string.sub(text, i, i)
	lbl.Font = Enum.Font.GothamBold
	lbl.TextScaled = true
	lbl.TextColor3 = WHITE
	lbl.TextStrokeTransparency = 0.85
	lbl.TextStrokeColor3 = Color3.new(0, 0, 0)

	table.insert(letters, lbl)
end

-- ✅ 节奏放慢，但仍连续
local animTime = 0.28
local stagger = 0.18 -- 下一个字提前进入

for i, lbl in ipairs(letters) do
	task.delay((i - 1) * stagger, function()
		lbl.TextColor3 = BLUE
		TweenService:Create(lbl, TweenInfo.new(animTime, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.fromScale(0.095, 0.19)
		}):Play()

		task.wait(animTime)

		TweenService:Create(lbl, TweenInfo.new(animTime * 0.9), {
			Size = UDim2.fromScale(0.05, 0.1)
		}):Play()
	end)
end

task.wait(#letters * stagger + animTime * 2 + 0.2)

-- 整体跳动（放慢）
for i = 1, 2 do
	for _, lbl in ipairs(letters) do
		TweenService:Create(lbl, TweenInfo.new(0.35), {
			Size = UDim2.fromScale(0.09, 0.18),
			TextColor3 = WHITE
		}):Play()
	end
	task.wait(0.35)

	for _, lbl in ipairs(letters) do
		TweenService:Create(lbl, TweenInfo.new(0.35), {
			Size = UDim2.fromScale(0.05, 0.1),
			TextColor3 = BLUE
		}):Play()
	end
	task.wait(0.35)
end

-- 消失（放慢）
for _, lbl in ipairs(letters) do
	TweenService:Create(lbl, TweenInfo.new(0.5), {
		TextTransparency = 1
	}):Play()
end
TweenService:Create(bg, TweenInfo.new(0.5), {
	BackgroundTransparency = 1
}):Play()

task.wait(0.5)
gui:Destroy()


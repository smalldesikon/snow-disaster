local currentGameId = game.PlaceId
local gameConfigs = {
    [1345139196] = {
        name = "寻宝模拟器",
        scriptUrl = "https://raw.githubusercontent.com/smalldesikon/snow-disaster/refs/heads/main/%E5%AF%BB%E5%AE%9D%E6%A8%A1%E6%8B%9F%E5%99%A8"
    }
}

local config = gameConfigs[currentGameId]

local function showNotification(message)
    local player = game:GetService("Players").LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Parent = playerGui
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 300, 0, 60)
    frame.Position = UDim2.new(1, 10, 1, 10)
    frame.BackgroundTransparency = 1
    frame.Parent = screenGui
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.Position = UDim2.new(0, 0, 0, 0)
    textLabel.Text = message
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextScaled = true
    textLabel.BackgroundTransparency = 1
    textLabel.Font = Enum.Font.GothamBold
    textLabel.Parent = frame
    
    -- 从右下角滑入动画
    frame.Position = UDim2.new(1, 0, 1, 0)  -- 右下角
    task.wait(0.1)
    frame:TweenPosition(
        UDim2.new(1, -310, 1, -70),  -- 滑入位置
        Enum.EasingDirection.Out,
        Enum.EasingStyle.Quad,
        0.3
    )
    
    -- 2秒后淡出
    task.delay(2, function()
        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = game:GetService("TweenService"):Create(textLabel, tweenInfo, {TextTransparency = 1})
        tween:Play()
        tween.Completed:Wait()
        screenGui:Destroy()
    end)
end

if config then
    showNotification("正在执行"..config.name.."")
    
    task.spawn(function()
        local success, errorMsg = pcall(function()
            if config.scriptUrl then
                loadstring(game:HttpGet(config.scriptUrl))()
            end
        end)
    end)
else
    showNotification("没有此服务器")
end
